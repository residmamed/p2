ZYTE_API_KEY=your_zyte_api_key_here

# Trending feature (optional — only needed for the Idea -> Pinterest flow)
APIFY_TOKEN=your_apify_token_here
PINTEREST_ACTOR=fetch_cat~pinterest-search-scraper
GOOGLE_LENS_ACTOR=borderline~google-lens

# Image sourcing (/api/sourcing/image) — cloud browsers that drive the supplier
# sites' photo-upload widgets. Required for that endpoint; nothing else uses it.
BROWSERBASE_API_KEY=your_browserbase_api_key_here
BROWSERBASE_PROJECT_ID=your_browserbase_project_id_here
BROWSERBASE_PROXIES=true
# Advanced stealth is plan-gated — leave false on Free/Developer.
BROWSERBASE_ADVANCED_STEALTH=false

# SerpApi — three features share this one quota:
#   Amazon + Walmart best-seller results (app/serpapi_retail.py), 1 search per
#   site per query; Google Lens picture search (app/serp_lens.py), 2 per photo.
# Unset => Amazon uses Rainforest, Walmart uses Zyte, Lens is unavailable.
SERPAPI_KEY=your_serpapi_key_here

# Amazon's secondary source, behind SerpApi. Exact review counts (SerpApi
# rounds them) and cover for when the SerpApi quota runs out.
RAINFOREST_API_KEY=your_rainforest_key_here

# Captcha solving for Alibaba/AliExpress image search (optional)
CAPSOLVER_API_KEY=your_capsolver_api_key_here
TWOCAPTCHA_API_KEY=your_2captcha_api_key_here

# Claude agents (app/claude_agent.py). Two jobs no scraped field can do:
#   1. screen search results so a query for "tumbler" stops returning lids,
#      straws and unrelated stock alongside the tumblers;
#   2. decide whether a supplier's catalogue photo is the same product as the
#      buyer's photo, which perceptual hashing cannot (a re-shot product hashes
#      nothing like the original).
# Unset => both degrade to the pre-Claude behaviour with a warning, never to an
# empty grid. Set either flag to false to switch that agent off without a code
# change (a cost or outage decision, not a deploy).
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-opus-5
CLAUDE_RELEVANCE_FILTER=true
CLAUDE_VISUAL_MATCHING=true
