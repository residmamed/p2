{
  "manifest_version": 3,
  "name": "Zyte Lens Bridge",
  "version": "1.0.0",
  "description": "Runs a Google Lens reverse-image search in a real browser tab on behalf of the Zyte sourcing app, and returns results to it.",
  "key": "",
  "permissions": ["scripting", "tabs"],
  "host_permissions": [
    "https://www.google.com/*",
    "https://lens.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost:5173/*",
      "http://127.0.0.1:5173/*"
    ]
  }
}
